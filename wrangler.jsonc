/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "chara-api",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-03",
    "d1_databases": [
        {
          "binding": "DB",
          "database_name": "Chara",
          "database_id": "ffbf29e1-59ff-4810-87c8-56a282453009"
        }
    ],
    "secrets_store_secrets": [
        {
            "store_id": "765e7844737645268bd29649ff4c22d8",
            "binding": "SECRET",
            "secret_name": "chara"
        }
    ],
	"observability": {
		"enabled": true
	}
}
